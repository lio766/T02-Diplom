<!doctype html>
<html lang="de">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Buchung ausstehend</title>
</head>
<body style="margin:0;padding:0;background-color:#eef2ff;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
	<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#eef2ff;padding:28px 10px;">
		<tr>
			<td align="center">
				<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:680px;">
					<tr>
						<td style="padding:0 0 12px 0;text-align:center;font-size:12px;color:#64748b;letter-spacing:0.4px;">
							AGORA RAUMMANAGEMENT
						</td>
					</tr>
					<tr>
						<td style="background-color:#ffffff;border:1px solid #dbe3f4;border-radius:16px;overflow:hidden;">
							<table role="presentation" width="100%" cellspacing="0" cellpadding="0">
								<tr>
									<td style="padding:26px 26px 24px 26px;background-color:#0f172a;">
										<table role="presentation" width="100%" cellspacing="0" cellpadding="0">
											<tr>
												<td style="font-size:12px;color:#93c5fd;text-transform:uppercase;letter-spacing:0.8px;padding-bottom:8px;">
													Anfrage eingegangen
												</td>
											</tr>
											<tr>
												<td style="font-size:26px;line-height:1.2;font-weight:700;color:#ffffff;padding-bottom:10px;">
													Buchung wartet auf Freigabe
												</td>
											</tr>
											<tr>
												<td style="font-size:14px;line-height:1.6;color:#cbd5e1;">
													Wir haben Ihre Buchung gespeichert. Sobald sie genehmigt wurde, erhalten Sie automatisch eine weitere E-Mail.
												</td>
											</tr>
										</table>
									</td>
								</tr>

								<tr>
									<td style="padding:22px 22px 6px 22px;">
										<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;">
											<tr>
												<td style="padding:16px 16px 8px 16px;font-size:13px;color:#475569;">
													Status
												</td>
											</tr>
											<tr>
												<td style="padding:0 16px 16px 16px;">
													<span style="display:inline-block;padding:6px 12px;background-color:#dbeafe;border:1px solid #93c5fd;border-radius:999px;color:#1d4ed8;font-size:12px;font-weight:700;letter-spacing:0.3px;">AUSSTEHEND</span>
												</td>
											</tr>
										</table>
									</td>
								</tr>

								<tr>
									<td style="padding:12px 22px 8px 22px;">
										<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
											<tr>
												<td colspan="2" style="padding:14px 16px;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:14px;font-weight:700;color:#0f172a;">
													Buchungsdetails
												</td>
											</tr>
											<tr>
												<td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;width:36%;font-size:12px;color:#64748b;">Titel</td>
												<td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:14px;color:#0f172a;font-weight:700;">{{ booking_name }}</td>
											</tr>
											<tr>
												<td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:12px;color:#64748b;">Raum</td>
												<td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:14px;color:#0f172a;">{{ room_name }}</td>
											</tr>
											<tr>
												<td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:12px;color:#64748b;">Datum</td>
												<td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:14px;color:#0f172a;">{{ date }}</td>
											</tr>
											<tr>
												<td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:12px;color:#64748b;">Zeit</td>
												<td style="padding:12px 16px;border-bottom:1px solid #e2e8f0;font-size:14px;color:#0f172a;">{{ start_time }} - {{ end_time }}</td>
											</tr>
											<tr>
												<td style="padding:12px 16px;font-size:12px;color:#64748b;">Angelegt von</td>
												<td style="padding:12px 16px;font-size:14px;color:#0f172a;">{{ requester_name }}</td>
											</tr>
										</table>
									</td>
								</tr>

								{% if description %}
								<tr>
									<td style="padding:10px 22px 8px 22px;">
										<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#fff7ed;border:1px solid #fed7aa;border-radius:12px;">
											<tr>
												<td style="padding:12px 14px 6px 14px;font-size:12px;color:#9a3412;">Beschreibung</td>
											</tr>
											<tr>
												<td style="padding:0 14px 14px 14px;font-size:14px;line-height:1.6;color:#7c2d12;">{{ description }}</td>
											</tr>
										</table>
									</td>
								</tr>
								{% endif %}

								{% if participants and participants.size > 0 %}
								<tr>
									<td style="padding:10px 22px 16px 22px;">
										<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border:1px solid #e2e8f0;border-radius:12px;">
											<tr>
												<td style="padding:12px 14px 2px 14px;font-size:12px;color:#64748b;">Teilnehmer</td>
											</tr>
											<tr>
												<td style="padding:0 14px 14px 14px;font-size:14px;color:#0f172a;line-height:1.6;">
													<ul style="margin:0;padding-left:18px;">
														{% for participant in participants %}
														<li style="padding:2px 0;">{{ participant }}</li>
														{% endfor %}
													</ul>
												</td>
											</tr>
										</table>
									</td>
								</tr>
								{% endif %}

								<tr>
									<td style="padding:16px 24px;background-color:#f8fafc;border-top:1px solid #e2e8f0;font-size:12px;line-height:1.6;color:#64748b;">
										Diese E-Mail wurde automatisch von AGORA erstellt. Bitte antworten Sie nicht direkt auf diese Nachricht.
									</td>
								</tr>
							</table>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>